# Copy to .env (or set these in your .mcp.json "env" block) and fill in.
# `.env` is gitignored — never commit real tokens.

# Your OWN Discord bot token. Each teammate runs their own bot so that
# message authorship can be verified. See README "1. Create your Discord bot".
DISCORD_BOT_TOKEN=

# Optional: where team-relay keeps its config and local state.
# Defaults to ./.team-relay in the directory Claude Code runs from.
# TEAM_RELAY_CONFIG_DIR=
